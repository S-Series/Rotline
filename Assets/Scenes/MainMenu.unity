  m_Text: "\uD544\uB4DC\uC5D0\uC11C \uC0B4\uC544\uB0A8\uAE30\n\nGameplay\uC5D0 \uBC30\uCE58\uD55C
    \uD544\uB4DC\uC5D0\uC11C 10\uBD84 \uC0DD\uC874.\n\uACBD\uD5D8\uCE58\uB97C \uBAA8\uC73C\uACE0
    \uC544\uC774\uD15C \uD6A8\uACFC\uB97C \uC911\uCCA9\uD558\uC138\uC694.\n\n\uC2E4\uD328\uD574\uB3C4
    \uC815\uC218\uB97C \uC5BB\uC5B4 \uB2E4\uC74C \uB3C4\uC804\uC744 \uC900\uBE44\uD569\uB2C8\uB2E4.\n\uBB34\uC791\uC704
